@model List<hospital.Models.Department>

@{
    ViewData["Title"] = "Add Doctor";
}

<div class="container mt-4">

    <h2>New Doctor</h2>
    <hr />

    <form action="/Doctor/SaveAdd" method="post">

        <div class="mb-3">
            <label>Name:</label>
            <input type="text"
                   class="form-control"
                   name="Name"
                   placeholder="Enter Name">
        </div>

        <div class="mb-3">
            <label>Age:</label>
            <input type="number"
                   class="form-control"
                   name="Age"
                   placeholder="Enter Age">
        </div>

        <div class="mb-3">
            <label>Email:</label>
            <input type="email"
                   class="form-control"
                   name="Email"
                   placeholder="Enter Email">
        </div>

        <div class="mb-3">
            <label>Phone:</label>
            <input type="text"
                   class="form-control"
                   name="Phone"
                   placeholder="Enter Phone">
        </div>

        <div class="mb-3">
            <label>Salary:</label>
            <input type="number"
                   step="0.01"
                   class="form-control"
                   name="Salary"
                   placeholder="Enter Salary">
        </div>

        <div class="mb-3">
            <label>Department:</label>

            <select name="Department_ID" class="form-control">

                <option value="">
                    Select Department
                </option>

                @foreach (var item in Model)
                {
                    <option value="@item.Department_ID">
                        @item.Department_Name
                    </option>
                }

            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Submit
        </button>

        <a href="/Doctor/Index"
           class="btn btn-secondary">
            Back
        </a>

    </form>

</div>