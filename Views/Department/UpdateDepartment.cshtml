@model hospital.Models.Department

@{
    ViewData["Title"] = "Update Department";
}

<div class="container mt-4">

    <h2>Update Department</h2>
    <hr />

    <form action="/Department/SaveUpdate"
          method="post">

        <input type="hidden"
               name="Department_ID"
               value="@Model.Department_ID" />

        <div class="mb-3">

            <label>Department Name:</label>

            <input type="text"
                   class="form-control"
                   name="Department_Name"
                   value="@Model.Department_Name">

        </div>

        <div class="mb-3">

            <label>Description:</label>

            <textarea class="form-control"
                      name="Description">@Model.Description</textarea>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Save Update
        </button>

        <a href="/Department/Departments"
           class="btn btn-secondary">
            Back
        </a>

    </form>

</div>