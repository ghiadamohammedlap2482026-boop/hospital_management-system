@model List<hospital.Models.Department>

@{
    ViewData["Title"] = "Department List";
}

<div class="container mt-4">

    <h2>Department List</h2>
    <hr />

    <a href="/Department/AddDepartment"
       class="btn btn-info mb-3">
        Add Department
    </a>

    <table class="table table-striped table-hover">

        <thead class="table-dark">

            <tr>
                <th>ID</th>
                <th>Department Name</th>
                <th>Description</th>
                <th>Action</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var dept in Model)
            {
                <tr>

                    <td>
                        @dept.Department_ID
                    </td>

                    <td>
                        @dept.Department_Name
                    </td>

                    <td>
                        @dept.Description
                    </td>

                    <td>

                        <a href="/Department/Details/@dept.Department_ID"
                           class="btn btn-success">
                            Details
                        </a>

                        <a href="/Department/UpdateDepartment/@dept.Department_ID"
                           class="btn btn-warning">
                            Update
                        </a>


                    </td>

                </tr>
            }

        </tbody>

    </table>

    <a href="/Home/Index"
       class="btn btn-secondary">
        Back
    </a>

</div>