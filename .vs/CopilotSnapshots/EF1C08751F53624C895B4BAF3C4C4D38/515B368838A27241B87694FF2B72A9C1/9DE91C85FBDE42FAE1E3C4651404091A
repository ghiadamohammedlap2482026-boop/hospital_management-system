@{
    ViewData["Title"] = "Home";
}

<style>
    body {
        background: #f4f8fb;
    }

    .hospital-home {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 15px;
    }

    .welcome-box {
        width: 100%;
        max-width: 1100px;
        background: white;
        border-radius: 25px;
        padding: 50px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    .hospital-title {
        font-size: 42px;
        font-weight: 700;
        color: #173b57;
        margin-bottom: 10px;
    }

    .hospital-subtitle {
        color: #718096;
        font-size: 18px;
        margin-bottom: 45px;
    }

    .dashboard-card {
        display: block;
        text-decoration: none;
        background: #fff;
        border: 1px solid #e8eef3;
        border-radius: 20px;
        padding: 30px 20px;
        text-align: center;
        transition: all 0.3s ease;
        height: 100%;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.04);
    }

    .dashboard-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
        text-decoration: none;
    }

    .icon-box {
        width: 75px;
        height: 75px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 34px;
    }

    .department-icon {
        background: #e8f3ff;
        color: #1976d2;
    }

    .doctor-icon {
        background: #e8fff5;
        color: #198754;
    }

    .patient-icon {
        background: #fff4e5;
        color: #f59e0b;
    }

    .treatment-icon {
        background: #ffecef;
        color: #dc3545;
    }

    .dashboard-card h3 {
        color: #173b57;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .dashboard-card p {
        color: #8492a6;
        margin: 0;
        font-size: 14px;
    }

    .welcome-icon {
        font-size: 55px;
        margin-bottom: 15px;
    }

    @@media (max-width: 768px) {
        .welcome-box {
            padding: 30px 20px;
        }

        .hospital-title {
            font-size: 32px;
        }
    }
</style>

<div class="hospital-home">

    <div class="welcome-box">

        <div class="text-center">

            <div class="welcome-icon">
                🏥
            </div>

            <h1 class="hospital-title">
                Hospital Management System
            </h1>

            <p class="hospital-subtitle">
                Welcome to the Hospital Management Dashboard
            </p>

        </div>

        <div class="row g-4">

            <!-- Departments -->
            <div class="col-lg-3 col-md-6">
                <a asp-controller="Department"
                   asp-action="Departments"
                   class="dashboard-card">

                    <div class="icon-box department-icon">
                        🏢
                    </div>

                    <h3>Departments</h3>

                    <p>
                        Manage hospital departments
                    </p>

                </a>
            </div>


            <!-- Doctors -->
            <div class="col-lg-3 col-md-6">
                <a asp-controller="Doctor"
                   asp-action="Index"
                   class="dashboard-card">

                    <div class="icon-box doctor-icon">
                        👨‍⚕️
                    </div>

                    <h3>Doctors</h3>

                    <p>
                        Manage doctors information
                    </p>

                </a>
            </div>


            <!-- Patients -->
            <div class="col-lg-3 col-md-6">
                <a asp-controller="Patient"
                   asp-action="Patient"
                   class="dashboard-card">

                    <div class="icon-box patient-icon">
                        🧑‍🤝‍🧑
                    </div>

                    <h3>Patients</h3>

                    <p>
                        Manage patients information
                    </p>

                </a>
            </div>


            <!-- Treatments -->
            <div class="col-lg-3 col-md-6">
                <a asp-controller="Treatment"
                   asp-action="Treatments"
                   class="dashboard-card">

                    <div class="icon-box treatment-icon">
                        💊
                    </div>

                    <h3>Treatments</h3>

                    <p>
                        Manage patient treatments
                    </p>

                </a>
            </div>

        </div>

    </div>

</div>