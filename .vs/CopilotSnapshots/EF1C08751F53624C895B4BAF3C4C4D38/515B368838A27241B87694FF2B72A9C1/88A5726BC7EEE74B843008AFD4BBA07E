@model hospital.Models.Treatment

@{
    ViewData["Title"] = "Treatment Details";
}

<div class="container mt-4">

    <h2>Treatment Details</h2>

    <div class="card mt-3">

        <div class="card-body">

            <p>
                <strong>ID:</strong>
                @Model.Treatment_ID
            </p>

            <p>
                <strong>Doctor:</strong>
                @Model.Doctor?.Name
            </p>

            <p>
                <strong>Patient:</strong>
                @Model.Patient?.Name
            </p>

            <p>
                <strong>Diagnosis:</strong>
                @Model.Diagnosis
            </p>

            <a asp-action="UpdateTreatment"
               asp-route-id="@Model.Treatment_ID"
               class="btn btn-warning">
                Update
            </a>

            <a asp-action="Treatments"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>