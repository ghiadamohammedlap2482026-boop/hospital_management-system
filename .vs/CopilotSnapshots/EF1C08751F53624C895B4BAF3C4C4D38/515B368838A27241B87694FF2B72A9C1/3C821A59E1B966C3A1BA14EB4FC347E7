@model List<hospital.Models.Treatment>

@{
    ViewData["Title"] = "Treatments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Treatments</h2>

        <a asp-action="AddTreatment"
           class="btn btn-primary">
            Add Treatment
        </a>

    </div>

    <table class="table table-bordered table-striped">

        <thead class="table-dark">

            <tr>
                <th>ID</th>
                <th>Doctor</th>
                <th>Patient</th>
                <th>Diagnosis</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var treatment in Model)
            {
                <tr>

                    <td>
                        @treatment.Treatment_ID
                    </td>

                    <td>
                        @treatment.Doctor?.Name
                    </td>

                    <td>
                        @treatment.Patient?.Name
                    </td>

                    <td>
                        @treatment.Diagnosis
                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@treatment.Treatment_ID"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="UpdateTreatment"
                           asp-route-id="@treatment.Treatment_ID"
                           class="btn btn-warning btn-sm">
                            Update
                        </a>

                        <a asp-action="DeleteTreatment"
                           asp-route-id="@treatment.Treatment_ID"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this treatment?');">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>